# Copy this file to `.env` and fill in your Supabase connection string.
#   cp .env.example .env
#
# Where to find it: Supabase dashboard -> your project -> Connect (top bar)
#   -> "ORMs" / "Connection string". Use the DIRECT connection or the
#   "Session" pooler (port 5432) — both support the schema migrations Prisma
#   runs. Avoid the "Transaction" pooler (port 6543) here, since the `pg`
#   driver uses prepared statements it doesn't fully support.
#
# Remember to URL-encode any special characters in your database password,
# and keep `?sslmode=require` (Supabase requires TLS).
#
# Format:
#   postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require

DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@YOUR_PROJECT.supabase.co:5432/postgres?sslmode=require"
